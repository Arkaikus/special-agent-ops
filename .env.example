# Gateway (optional overrides; defaults work for local sqlite + redis)
GATEWAY_DATABASE_URL=sqlite:///./data/gateway.db
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Agents (examples)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama: use http://ollama:11434/v1 when running the ollama compose profile,
# or http://localhost:11434/v1 for a host-installed Ollama instance.
OLLAMA_BASE_URL=http://ollama:11434/v1

# Gitea (docker-compose gitea + gitea-mcp). After the first-run install, create a PAT in the UI.
GITEA_ACCESS_TOKEN=

# Frontend (see frontend/.env.example)
# VITE_GATEWAY_URL=http://localhost:8000
