PORT = int(os.environ.get("PORT", "{{ port }}"))
REDIS_URL = os.environ.get("REDIS_URL", "redis://redis:6379/0")
GATEWAY_URL = os.environ.get("GATEWAY_URL", "").strip()
AGENT_NAME = os.environ.get("AGENT_NAME", "{{ agent_name }}").strip()
AGENT_HOST = os.environ.get("AGENT_HOST", "{{ agent_name }}").strip()
GATEWAY_HEARTBEAT_SEC = int(os.environ.get("GATEWAY_HEARTBEAT_SEC", "45"))
OLLAMA_BASE_URL = os.environ.get("OLLAMA_BASE_URL", "http://ollama:11434/v1").strip()
MCP_SERVERS = {{ mcp_servers_literal }}
_FS_ALLOW = {{ fs_allow_literal }}

_log = logging.getLogger("agent.runtime")


async def _register_with_gateway() -> None:
    if not GATEWAY_URL:
        return
    base = GATEWAY_URL.rstrip("/")
    payload: dict = {"name": AGENT_NAME, "host": AGENT_HOST, "port": PORT}
    try:
        async with httpx.AsyncClient(timeout=10.0) as client:
            r = await client.post(f"{base}/api/agents/register", json=payload)
            r.raise_for_status()
    except Exception as e:
        _log.warning("Gateway register failed: %s", e)


async def _gateway_heartbeat_loop() -> None:
    while True:
        await asyncio.sleep(GATEWAY_HEARTBEAT_SEC)
        await _register_with_gateway()


def _mcp_http_headers(entry: dict) -> dict | None:
    h = dict(entry.get("headers") or {})
    b = entry.get("bearerFromEnv")
    if b:
        t = os.environ.get(b, "")
        h["Authorization"] = f"Bearer {t}"
    return h or None


def _build_mcp_toolsets() -> list:
    """Build MCP server toolset objects.

    Iterates MCP_SERVERS unconditionally (safe when the list is empty).
    MCP servers may be declared via ``mcp:`` or as dict entries inside
    ``tools:`` — both are merged into MCP_SERVERS by the manifest loader.
    """
    toolsets = []
    for entry in MCP_SERVERS:
        name = entry.get("name") or "mcp"
        transport = entry.get("transport") or "stdio"
        if transport == "stdio" and entry.get("command"):
            toolsets.append(
                MCPServerStdio(
                    entry["command"],
                    entry.get("args") or [],
                    tool_prefix=name,
                    env=os.environ.copy(),
                )
            )
        elif transport == "sse" and entry.get("url"):
            hdrs = _mcp_http_headers(entry)
            toolsets.append(MCPServerSSE(entry["url"], tool_prefix=name, headers=hdrs))
        elif transport == "http" and entry.get("url"):
            hdrs = _mcp_http_headers(entry)
            toolsets.append(MCPServerHTTP(entry["url"], tool_prefix=name, headers=hdrs))
    return toolsets


def _build_fs_toolset() -> list:
    """Wrap allowed fs-tool callables in a FunctionToolset.

    Returns a one-element list (or empty) so the result can be directly
    concatenated with the MCP toolsets list and passed to toolsets=.
    """
{% if has_fs %}
    reg = {
        "ls": workspace_tools.tool_ls,
        "grep": workspace_tools.tool_grep,
        "edit": workspace_tools.tool_edit,
        "glob": workspace_tools.tool_glob,
        "bash": workspace_tools.tool_bash,
    }
    fns = [reg[k] for k in _FS_ALLOW if k in reg]
    return [FunctionToolset(fns)] if fns else []
{% else %}
    return []
{% endif %}


def build_agent() -> Agent[None, str]:
    system_prompt = """{{ system_prompt | e }}"""
{% if model.provider == "anthropic" %}
    _ = os.environ.get("{{ model.api_key_env }}")
    model = AnthropicModel("{{ model.model_id }}")
{% elif model.provider == "ollama" %}
    model = OllamaModel(
        "{{ model.model_id }}",
        provider=OllamaProvider(
            base_url="{{ model.base_url }}",
        ),
    )
{% else %}
    _key = (
        os.environ.get("{{ model.api_key_env }}", "sk-local")
        if "{{ model.api_key_env }}"
        else "sk-local"
    )
    model = OpenAIChatModel(
        "{{ model.model_id }}",
        provider=OpenAIProvider(base_url="{{ model.base_url }}", api_key=_key),
    )
{% endif %}
    # All tool providers (MCP servers + fs-tool FunctionToolset) go into
    # a single toolsets= kwarg — pydantic-ai >= 0.0.24 unified API.
    toolsets = _build_mcp_toolsets() + _build_fs_toolset()
    kw: dict = {"model": model, "system_prompt": system_prompt}
    if toolsets:
        kw["toolsets"] = toolsets
    return Agent(**kw)


_agent: Agent[None, str] | None = None
_heartbeat_task: asyncio.Task[None] | None = None


@asynccontextmanager
async def lifespan(app: FastAPI):
    global _agent, _heartbeat_task
    _agent = build_agent()
    await _register_with_gateway()
    if GATEWAY_URL and GATEWAY_HEARTBEAT_SEC > 0:
        _heartbeat_task = asyncio.create_task(_gateway_heartbeat_loop())
    try:
        yield
    finally:
        if _heartbeat_task is not None:
            _heartbeat_task.cancel()
            try:
                await _heartbeat_task
            except asyncio.CancelledError:
                pass
            _heartbeat_task = None
        _agent = None


app = FastAPI(title="{{ agent_name }}", lifespan=lifespan)


class InvokeBody(BaseModel):
    message: str = Field(..., min_length=1)
    context: dict | None = None


@app.get("/health")
async def health():
    return {"status": "ok", "agent": "{{ agent_name }}"}


@app.post("/invoke")
async def invoke(body: InvokeBody):
    assert _agent is not None
    text = body.message
    if body.context:
        text = f"{body.message}\n\n(Gateway context: {json.dumps(body.context, sort_keys=True)})"
    result = await _agent.run(text)
    return {"output": result.output}


@app.post("/invoke/stream")
async def invoke_stream(body: InvokeBody):
    assert _agent is not None
    text = body.message
    if body.context:
        text = f"{body.message}\n\n(Gateway context: {json.dumps(body.context, sort_keys=True)})"

    async def _generate():
        try:
            async with _agent.run_stream(text) as result:
                async for chunk in result.stream_text(delta=True):
                    # Replace newlines to keep each chunk as a single SSE data line
                    yield f"data: {chunk.replace(chr(10), ' ')}\n\n"
        except Exception as exc:
            yield f"data: [ERROR] {exc!s}\n\n"
        yield "data: [DONE]\n\n"

    return StreamingResponse(
        _generate(),
        media_type="text/event-stream",
        headers={"X-Accel-Buffering": "no", "Cache-Control": "no-cache"},
    )
