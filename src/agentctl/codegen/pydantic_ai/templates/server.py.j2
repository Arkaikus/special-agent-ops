_heartbeat_task: asyncio.Task[None] | None = None


@asynccontextmanager
async def lifespan(app: FastAPI):
    global _heartbeat_task
    await _register_with_gateway()
    if GATEWAY_URL and GATEWAY_HEARTBEAT_SEC > 0:
        _heartbeat_task = asyncio.create_task(_gateway_heartbeat_loop())
    try:
{% if has_mcp %}
        async with agent.run_mcp_servers():
            yield
{% else %}
        yield
{% endif %}
    finally:
        if _heartbeat_task is not None:
            _heartbeat_task.cancel()
            try:
                await _heartbeat_task
            except asyncio.CancelledError:
                pass
            _heartbeat_task = None


app = FastAPI(title="{{ agent_name }}", lifespan=lifespan)


class InvokeBody(BaseModel):
    message: str = Field(..., min_length=1)
    context: dict | None = None


@app.get("/health")
async def health():
    return {"status": "ok", "agent": "{{ agent_name }}"}


@app.post("/invoke")
async def invoke(body: InvokeBody):
    text = body.message
    if body.context:
        text = f"{body.message}\n\n(Gateway context: {json.dumps(body.context, sort_keys=True)})"
    result = await agent.run(text)
    return {"output": result.output}


@app.post("/invoke/stream")
async def invoke_stream(body: InvokeBody):
    text = body.message
    if body.context:
        text = f"{body.message}\n\n(Gateway context: {json.dumps(body.context, sort_keys=True)})"

    async def _generate():
        try:
            # agent.iter() runs the full tool-call loop and yields each graph node,
            # giving visibility into every tool invocation before emitting the final text.
            async with agent.iter(text) as run:
                async for node in run:
                    if Agent.is_call_tools_node(node):
                        for part in node.model_response.parts:
                            if hasattr(part, "tool_name"):
                                try:
                                    args_display = (
                                        json.dumps(part.args)
                                        if isinstance(part.args, dict)
                                        else str(part.args)
                                    )
                                except Exception:
                                    args_display = str(part.args)
                                yield f"data: [TOOL_CALL] {part.tool_name}({args_display})\n\n"
                    elif Agent.is_end_node(node):
                        output = node.data.output
                        # Replace newlines to keep each chunk as a single SSE data line
                        yield f"data: {output.replace(chr(10), ' ')}\n\n"
        except Exception as exc:
            yield f"data: [ERROR] {exc!s}\n\n"
        yield "data: [DONE]\n\n"

    return StreamingResponse(
        _generate(),
        media_type="text/event-stream",
        headers={"X-Accel-Buffering": "no", "Cache-Control": "no-cache"},
    )
